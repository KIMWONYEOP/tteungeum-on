# Runtime: production always requires Supabase. Mock is allowed only in next dev.
APP_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only when your project still uses the anon JWT key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only tools (never NEXT_PUBLIC, never used by application routes):
SUPABASE_SERVICE_ROLE_KEY=
# Development seed: explicitly designate a separate development project.
SUPABASE_DEV_PROJECT_URL=
ALLOW_DEVELOPMENT_SEED=false
SEED_USER_PASSWORD=
# Isolated PostgreSQL test container; not your production database:
TEST_DATABASE_URL=
